{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PowerShell Launch Script",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/src/helper-functions/Publish-Main.ps1",
      "cwd": "${cwd}",
      "args": ["-RootDirectory", "${workspaceFolder}"]
    },
    {
      "name": "Pester: Unit Tests",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tests/Run-Tests.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true,
      "args": ["-TestType", "Unit"]
    },
    {
      // Missing ADO_* variables are filled from the Azure CLI login (az login). Requires tests/Initialize-IntegrationTestData.ps1 to have been run.
      "name": "Pester: Integration Tests",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tests/Run-Tests.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true,
      "args": ["-TestType", "Integration"]
    },
    {
      // Service principal tests need ADO_CLIENT_ID, ADO_CLIENT_SECRET, and ADO_TENANT_ID; managed identity tests only work on Azure-hosted agents.
      "name": "Pester: Authentication Tests",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tests/Run-Tests.ps1",
      "cwd": "${workspaceFolder}",
      "createTemporaryIntegratedConsole": true,
      "args": ["-TestType", "Authentication"]
    }
  ]
}
